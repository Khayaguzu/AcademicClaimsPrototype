@model AcademicClaimsPrototype.Models.InvoiceViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>University Claims Invoice</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
            color: #333;
        }

        .header {
            text-align: center;
            border-bottom: 2px solid #2c3e50;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }

        .title {
            font-size: 24px;
            font-weight: bold;
            color: #2c3e50;
            margin-bottom: 10px;
        }

        .details {
            margin-bottom: 30px;
        }

            .details table {
                width: 100%;
                border-collapse: collapse;
            }

            .details td {
                padding: 5px 0;
            }

            .details .label {
                font-weight: bold;
                width: 150px;
            }

        .claims-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
        }

            .claims-table th {
                background-color: #2c3e50;
                color: white;
                padding: 12px;
                text-align: left;
                border: 1px solid #2c3e50;
            }

            .claims-table td {
                padding: 10px;
                border: 1px solid #ddd;
            }

            .claims-table tr:nth-child(even) {
                background-color: #f8f9fa;
            }

        .total-row {
            font-weight: bold;
            background-color: #e9ecef !important;
        }

        .amount {
            text-align: right;
        }

        .date {
            text-align: right;
        }

        .footer {
            margin-top: 50px;
            text-align: center;
            font-size: 12px;
            color: #6c757d;
        }

        .total-section {
            text-align: right;
            font-size: 18px;
            font-weight: bold;
            margin-top: 20px;
            padding: 15px;
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="title">UNIVERSITY CLAIMS INVOICE</div>
    </div>

    <div class="details">
        <table>
            <tr>
                <td class="label">Lecturer:</td>
                <td>@Model.LecturerEmail</td>
            </tr>
            <tr>
                <td class="label">Generated Date:</td>
                <td>@Model.GeneratedDate.ToString("yyyy-MM-dd HH:mm")</td>
            </tr>
            <tr>
                <td class="label">Number of Claims:</td>
                <td>@Model.Claims.Count</td>
            </tr>
        </table>
    </div>

    <table class="claims-table">
        <thead>
            <tr>
                <th>Description</th>
                <th>Date</th>
                <th>Hours</th>
                <th>Rate (R)</th>
                <th>Amount (R)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var claim in Model.Claims)
            {
                <tr>
                    <td>@claim.Description</td>
                    <td class="date">@claim.Date.ToString("yyyy-MM-dd")</td>
                    <td class="amount">@claim.Hours</td>
                    <td class="amount">@claim.Rate.ToString("N2")</td>
                    <td class="amount">@claim.Amount.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="total-section">
        Total Amount: R @Model.TotalAmount.ToString("N2")
    </div>

    <div class="footer">
        <p>Generated by Academic Claims System - @DateTime.Now.Year</p>
    </div>
</body>
</html>