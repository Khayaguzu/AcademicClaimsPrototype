@model AcademicClaimsPrototype.Models.Claim

@{
    ViewData["Title"] = "Submit New Claim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Submit New Claim</h2>

@if (TempData["Error"] != null)
{
    <div style="color: red; margin-bottom: 15px;">
        @TempData["Error"]
    </div>
}

<form asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div>
        <label asp-for="Date">Date:</label>
        <input asp-for="Date" type="date" required
               value="@DateTime.Now.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="Date" style="color: red;"></span>
    </div>

    <div>
        <label asp-for="Description">Description:</label>
        <textarea asp-for="Description" required
                  placeholder="Enter claim description..."></textarea>
        <span asp-validation-for="Description" style="color: red;"></span>
    </div>

    <div>
        <label asp-for="Hours">Hours:</label>
        <input asp-for="Hours" type="number" step="0.5" min="0" max="1000" required
               placeholder="Enter hours worked" />
        <span asp-validation-for="Hours" style="color: red;"></span>
    </div>

    <div>
        <label asp-for="Rate">Rate per Hour:</label>
        <input asp-for="Rate" type="number" step="0.01" min="0" max="100000" required
               placeholder="Enter hourly rate" />
        <span asp-validation-for="Rate" style="color: red;"></span>
    </div>

    <div>
        <label for="file">Supporting Document (optional):</label>
        <input type="file" name="file" accept=".pdf,.doc,.docx,.jpg,.png" />
        <small>Supported formats: PDF, Word, JPG, PNG</small>
    </div>

    <div>
        <button type="submit" style="background: #28a745; color: white; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer;">
            Submit Claim
        </button>
        <a asp-action="Index" style="margin-left: 10px; padding: 10px 20px; background: #6c757d; color: white; text-decoration: none; border-radius: 4px;">
            Cancel
        </a>
    </div>
</form>

<style>
    form div {
        margin-bottom: 20px;
    }

    label {
        display: block;
        font-weight: bold;
        margin-bottom: 5px;
        color: #333;
    }

    input[type="text"],
    input[type="number"],
    input[type="date"],
    textarea,
    input[type="file"] {
        width: 100%;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 16px;
        box-sizing: border-box;
    }

    textarea {
        height: 100px;
        resize: vertical;
        font-family: Arial, sans-serif;
    }

        input:focus,
        textarea:focus {
            border-color: #007bff;
            outline: none;
            box-shadow: 0 0 5px rgba(0, 123, 255, 0.3);
        }

    small {
        color: #6c757d;
        font-size: 12px;
    }

    .field-validation-error {
        font-size: 14px;
    }
</style>

@section Scripts {
    <script>
        document.querySelector('input[type="file"]').addEventListener('change', function(e) {
            var file = e.target.files[0];
            if (file) {
                var fileSize = file.size / 1024 / 1024;
                if (fileSize > 10) {
                    alert('File size must be less than 10MB');
                    e.target.value = '';
                }
            }
        });

        function calculateAmount() {
            var hours = parseFloat(document.querySelector('#Hours').value) || 0;
            var rate = parseFloat(document.querySelector('#Rate').value) || 0;
            var amount = hours * rate;

            var amountDisplay = document.getElementById('amountDisplay');
            if (!amountDisplay) {
                amountDisplay = document.createElement('div');
                amountDisplay.id = 'amountDisplay';
                amountDisplay.style.marginTop = '10px';
                amountDisplay.style.padding = '10px';
                amountDisplay.style.backgroundColor = '#f8f9fa';
                amountDisplay.style.borderRadius = '4px';
                amountDisplay.style.fontWeight = 'bold';
                document.querySelector('form').insertBefore(amountDisplay, document.querySelector('form div:last-child'));
            }

            amountDisplay.innerHTML = 'Total Amount: ' + amount.toLocaleString('en-US', {
                style: 'currency',
                currency: 'USD'
            });
        }

        document.querySelector('#Hours').addEventListener('input', calculateAmount);
        document.querySelector('#Rate').addEventListener('input', calculateAmount);

        // Initial calculation
        calculateAmount();
    </script>
}