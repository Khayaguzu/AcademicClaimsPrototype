@model AcademicClaimsPrototype.Models.Claim

@{
    ViewData["Title"] = "Edit Claim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Edit Claim</h2>

@if (TempData["Error"] != null)
{
    <div style="color: red; margin-bottom: 15px;">
        @TempData["Error"]
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />

    <div>
        <label asp-for="Date">Date *</label>
        <input asp-for="Date" type="date" required />
        <span asp-validation-for="Date" style="color: red;"></span>
    </div>

    <div>
        <label asp-for="Description">Description *</label>
        <textarea asp-for="Description" required></textarea>
        <span asp-validation-for="Description" style="color: red;"></span>
    </div>

    <div>
        <label asp-for="Hours">Hours *</label>
        <input asp-for="Hours" type="number" step="0.5" min="0.5" max="1000" required />
        <span asp-validation-for="Hours" style="color: red;"></span>
    </div>

    <div>
        <label asp-for="Rate">Rate per Hour *</label>
        <input asp-for="Rate" type="number" step="0.01" min="1" max="100000" required />
        <span asp-validation-for="Rate" style="color: red;"></span>
    </div>

    <div>
        <label>Current Document:</label>
        @if (!string.IsNullOrEmpty(Model.DocumentPath))
        {
            <div>
                <a href="@Model.DocumentPath" target="_blank">View Current Document</a>
            </div>
            <small>Upload a new file below to replace the current document</small>
        }
        else
        {
            <div style="color: red;">No document attached - document is required</div>
        }
    </div>

    <div>
        <label for="file">Update Document *</label>
        <input type="file" name="file" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
        <small>Required - Supported formats: PDF, Word, JPG, PNG (maximum 10MB)</small>
        <span style="color: red;" id="fileValidation"></span>
        @if (ViewData.ModelState["file"]?.Errors?.Count > 0)
        {
            <span style="color: red;">@ViewData.ModelState["file"].Errors.First().ErrorMessage</span>
        }
    </div>

    <div>
        <button type="submit" style="background: #28a745;">Update Claim</button>
        <a asp-action="Index" style="margin-left: 10px;">Cancel</a>
    </div>
</form>

<style>
    form div {
        margin-bottom: 15px;
    }

    label {
        display: block;
        font-weight: bold;
        margin-bottom: 5px;
    }

        /* Show asterisk for all required fields */
        label:after {
            content: " *";
            color: red;
        }

    input, textarea {
        width: 100%;
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 4px;
    }

    textarea {
        height: 100px;
        resize: vertical;
    }

    .alert-danger {
        background: #f8d7da;
        color: #721c24;
        padding: 10px;
        border-radius: 4px;
        margin-bottom: 15px;
        border: 1px solid #f5c6cb;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // File validation for edit form
        var fileInput = document.querySelector('input[type="file"]');
        var fileValidation = document.getElementById('fileValidation');
        var currentDocument = '@Model.DocumentPath';

        if (fileInput) {
            fileInput.addEventListener('change', function(e) {
                var file = e.target.files[0];
                if (file) {
                    var fileSize = file.size / 1024 / 1024;
                    if (fileSize > 10) {
                        fileValidation.textContent = 'File size must be less than 10MB';
                        e.target.value = '';
                    } else {
                        // Validate file extension
                        var allowedExtensions = ['.pdf', '.doc', '.docx', '.jpg', '.jpeg', '.png'];
                        var fileExtension = file.name.toLowerCase().substring(file.name.lastIndexOf('.'));
                        if (!allowedExtensions.includes(fileExtension)) {
                            fileValidation.textContent = 'Only PDF, Word, JPG, and PNG files are allowed';
                            e.target.value = '';
                        } else {
                            fileValidation.textContent = '';
                        }
                    }
                }
            });
        }

        // Form validation for edit
        var form = document.querySelector('form');
        form.addEventListener('submit', function(e) {
            var file = fileInput.files[0];
            var hasCurrentDocument = currentDocument && currentDocument.length > 0;

            // If no current document and no new file, prevent submission
            if (!hasCurrentDocument && !file) {
                fileValidation.textContent = 'Document is required';
                e.preventDefault();
                return;
            }

            if (file) {
                var fileSize = file.size / 1024 / 1024;
                if (fileSize > 10) {
                    fileValidation.textContent = 'File size must be less than 10MB';
                    e.preventDefault();
                }

                // Validate file extension
                var allowedExtensions = ['.pdf', '.doc', '.docx', '.jpg', '.jpeg', '.png'];
                var fileExtension = file.name.toLowerCase().substring(file.name.lastIndexOf('.'));
                if (!allowedExtensions.includes(fileExtension)) {
                    fileValidation.textContent = 'Only PDF, Word, JPG, and PNG files are allowed';
                    e.preventDefault();
                }
            }
        });
    });
</script>