@model AcademicClaimsPrototype.Models.Claim

@{
    ViewData["Title"] = "Edit Claim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Edit Claim</h2>

@if (TempData["Error"] != null)
{
    <div style="color: red; margin-bottom: 15px;">
        @TempData["Error"]
    </div>
}

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />

    <div>
        <label asp-for="Date">Date:</label>
        <input asp-for="Date" type="date" required />
        <span asp-validation-for="Date" style="color: red;"></span>
    </div>

    <div>
        <label asp-for="Description">Description:</label>
        <textarea asp-for="Description" required></textarea>
        <span asp-validation-for="Description" style="color: red;"></span>
    </div>

    <div>
        <label asp-for="Hours">Hours:</label>
        <input asp-for="Hours" type="number" step="0.5" min="0" max="1000" required />
        <span asp-validation-for="Hours" style="color: red;"></span>
    </div>

    <div>
        <label asp-for="Rate">Rate per Hour:</label>
        <input asp-for="Rate" type="number" step="0.01" min="0" max="100000" required />
        <span asp-validation-for="Rate" style="color: red;"></span>
    </div>

    <div>
        <label>Current Document:</label>
        @if (!string.IsNullOrEmpty(Model.DocumentPath))
        {
            <div>
                <a href="@Model.DocumentPath" target="_blank">View Current Document</a>
            </div>
        }
        else
        {
            <div>No document attached</div>
        }
    </div>

    <div>
        <label for="file">Update Document (optional):</label>
        <input type="file" name="file" />
        <small>Leave empty to keep current document</small>
    </div>

    <div>
        <button type="submit" style="background: #28a745;">Update Claim</button>
        <a asp-action="Index" style="margin-left: 10px;">Cancel</a>
    </div>
</form>

<style>
    form div {
        margin-bottom: 15px;
    }

    label {
        display: block;
        font-weight: bold;
        margin-bottom: 5px;
    }

    input, textarea {
        width: 100%;
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 4px;
    }

    textarea {
        height: 100px;
        resize: vertical;
    }
</style>